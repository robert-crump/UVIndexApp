<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Refresh button + loading indicator are kept only so the existing
             ACTION_REFRESH broadcast/pending intent keep working programmatically;
             not shown in the UI anymore, hence zero size. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/widget_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_refresh"
                android:background="@android:color/transparent"
                android:contentDescription="Aktualisieren"
                android:scaleType="centerInside" />

            <ProgressBar
                android:id="@+id/widget_loading_indicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:indeterminate="true" />
        </FrameLayout>

        <!-- UV Index Row: one continuous bar, no gaps between cells -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Current Hour (left end, rounded left corners) -->
            <LinearLayout
                android:id="@+id/widget_cell_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_row_bg_error_left">

                <TextView
                    android:id="@+id/widget_uv_hour_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/widget_time_hour_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <!-- Hour +1 (middle, square corners) -->
            <LinearLayout
                android:id="@+id/widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/widget_uv_error_background">

                <TextView
                    android:id="@+id/widget_uv_hour_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/widget_time_hour_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <!-- Hour +2 (middle, square corners) -->
            <LinearLayout
                android:id="@+id/widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/widget_uv_error_background">

                <TextView
                    android:id="@+id/widget_uv_hour_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/widget_time_hour_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <!-- Hour +3 (right end, rounded right corners) -->
            <LinearLayout
                android:id="@+id/widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_row_bg_error_right">

                <TextView
                    android:id="@+id/widget_uv_hour_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#999999" />

                <TextView
                    android:id="@+id/widget_time_hour_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider: thin edge-to-edge line separating the UV cells from the footer.
             Plain android.view.View is not in RemoteViews' inflatable class whitelist,
             so a FrameLayout is used to render the line instead. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white" />

        <!-- Footer: "UV-Index | City" -->
        <TextView
            android:id="@+id/widget_uv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/widget_uv_footer_background"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_uv_footer_no_city"
            android:textSize="10sp"
            android:textColor="@color/widget_uv_footer_gray" />

    </LinearLayout>

</FrameLayout>
