<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".UVIndexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UVIndex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.UVIndex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="Info"
            android:theme="@style/Theme.UVIndex" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.UVIndex" />

        <!-- Widget -->
        <receiver
            android:name=".widget.UVWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.uvindex.app.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/uv_widget_info" />
        </receiver>

        <!-- Current UV Widget -->
        <receiver
            android:name=".widget.UVWidgetCurrent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.uvindex.app.widget.ACTION_REFRESH_CURRENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/uv_widget_current_info" />
        </receiver>

        <!-- Wind Widget (1x1) -->
        <receiver
            android:name=".widget.WindWidget"
            android:exported="true"
            android:label="@string/wind_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wind_widget_info" />
        </receiver>

        <!-- Self-protection Time Widget (1x1) -->
        <receiver
            android:name=".widget.SelfProtectionTimeWidget"
            android:exported="true"
            android:label="@string/self_protection_time_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/self_protection_time_widget_info" />
        </receiver>

        <!-- Air Quality Widget (1x1) -->
        <receiver
            android:name=".widget.AirQualityWidget"
            android:exported="true"
            android:label="@string/air_quality_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/air_quality_widget_info" />
        </receiver>

        <receiver
            android:name=".worker.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.uvindex.app.DISABLE_UV_WARNINGS" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver für Screen Unlock und Boot -->
        <receiver
            android:name=".widget.ScreenUnlockReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>